{
  "name": "secretary-ai",
  "version": "0.0.1",
  "description": "Node.js SDK for building an MCP-powered virtual secretary with LangChain and LangGraph",
  "keywords": [
    "ai",
    "assistant",
    "langchain",
    "langgraph",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gotois/secretary-ai.git"
  },
  "homepage": "https://github.com/gotois/secretary-ai#readme",
  "bugs": {
    "url": "https://github.com/gotois/secretary-ai/issues"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "agent.js",
    "memory.js",
    "lib/minisearch.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "DEBUG=* & node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.2",
    "@langchain/langgraph": "1.4.7",
    "@langchain/langgraph-checkpoint": "1.1.3",
    "@langchain/mcp-adapters": "1.1.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "cheerio": "1.2.0",
    "debug": "4.4.3",
    "fast-xml-parser": "4.5.7",
    "jimp": "0.22.12",
    "jsqr": "1.4.0",
    "minisearch": "7.2.0",
    "music-metadata": "7.14.0",
    "node-fatsecret": "1.0.1",
    "openweather-apis": "4.5.0",
    "text-ld": "0.0.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@langchain/openai": "^1.5.5",
    "dotenv": "^17.4.2",
    "langchain-yandexgpt": "^0.0.10"
  }
}
